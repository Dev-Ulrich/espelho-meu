# URL pública confirmada da API Java, incluindo o prefixo se houver.
# Não colocar senhas, tokens ou segredos em variáveis VITE_.
VITE_API_BASE_URL='https://espelhomeu-api.onrender.com/'

# Opcional: habilita cadastro e listagem de teste SOMENTE em npm run dev.
# Preencher apenas com uma API ligada a banco de desenvolvimento autorizado.
# Vazio mantém a listagem pública sem cadastro; não há fallback para VITE_API_BASE_URL.
VITE_PRODUCT_DEMO_API_URL=''

# Opcional: por padrão, o build usa a API de IA publicada no Render.
VITE_IA_BASE_URL=https://espelho-meu-ia.onrender.com
